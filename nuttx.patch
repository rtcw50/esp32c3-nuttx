+
+C3C := c3c 
+
+C3CFLAGS := compile-only --single-module=yes -D NUTTX_PLATFORM --target elf-riscv32 --riscv-cpu=rvimac --custom-libc=yes --link-libc=yes --obj-out .
+
+# Create a linker command snippet that lists the undefined, weak symbols
+# in the C3 standard library.
+C3_GET_UNDEFINED_SYMBOLS = $(shell riscv-none-elf-nm  $1 | awk '$$2 == "w" || $$2 == "W" {printf " -u %s", $$3 } $$$$1 == "w" {printf " -u %s", $$2}')
+
+define C3_RENAME
+  $(Q) $(shell mv $(basename $1)$(OBJEXT) $2)
+endef
+
+# Not used: This function partially links the user file with the C3 standard library
+# to create the application object file. This is necessary because the references
+# in the application file after a c3c compile are weak and are not resolved by a 
+# normal link with the standard library object files. Also transforms module.o to
+# the long path name
+define C3_PARTIAL_LINK
+    $(Q) $(LD) -m elf32lriscv -r --gc-sections --entry=$(basename $1) -o $2 $(basename $1)$(OBJEXT)
+endef
+
+
+define C3_CREATE_LDFLAGS
+    mkdir -p $(APPDIR)$(DELIM)c3_ldflags
+    riscv-none-elf-nm $1 | awk '$$2 == "w" || $$2 == "W" {printf " -u %s", $$3 } $$1 == "w" {printf " -u %s", $$2}' > $(APPDIR)$(DELIM)c3_ldflags/$(PROGNAME).ldflags 
+endef
