+int esp_spi2_cmddata(struct spi_dev_s *dev, uint32_t devid, bool cmd)
+{
+  if (devid == SPIDEV_DISPLAY(0))
+    {
+      esp_gpiowrite(GPIO_LCD_DC, !cmd);
+    }
+
+  return OK;
+}   
+
+void esp_spi2_select(struct spi_dev_s *dev, uint32_t devid, bool cmd)
+{
+  if (devid == SPIDEV_DISPLAY(0))
+    {
+      esp_gpiowrite(CONFIG_ESPRESSIF_SPI2_CSPIN, !cmd);
+    }
+
+}   
