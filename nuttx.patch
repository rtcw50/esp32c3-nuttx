 	$(ECHO_END)
 endef
 
+# COMPILEZENC - Default macro to compile one Zenc file
+# Example: $(call COMPILEZENC, in-file, out-file)
+#
+# Depends on these settings defined in board-specific Make.defs file
+# installed at $(TOPDIR)/Make.defs:
+#
+#   ZENC - The command to invoke the Zenc compiler
+#   ZENCELFFLAGS - Options to pass to the Zenc compiler
+#
+# '<filename>.zenc_ZENCELFFLAGS += <options>' may also be used, as an example, to
+# change the options used with the single file <filename>.zenc. The same
+# applies mutatis mutandis.
+
+define COMPILEZENC
+	$(ECHO_BEGIN)"ZENC:  $1 "
+	$(Q) $(ZENC)  $(ZENCFLAGS) $($(strip $1)_ZENCFLAGS) $1 -o $(basename $1).zcc
+	$(ECHO_BEGIN)"CC: $(basename $1).zcc "
+	$(Q) $(CCACHE) $(CC) -x c -c $(CFLAGS) $3 $($(strip $1)_CFLAGS) $(basename $1).zcc -o $2
+	$(ECHO_END)
+endef
+
+
 # ASSEMBLE - Default macro to assemble one assembly language file
 # Example: $(call ASSEMBLE, in-file, out-file)
 #
@@ -672,6 +694,9 @@ ifeq ($(CONFIG_ARCH_TOOLCHAIN_TASKING),y)
 	EXTRA += *.src
 endif
 
+# When building with zenc, the .zcc files generated by zenc should also be cleaned up when "make clean" is invoked.
+EXTRA += *.zcc
+
 ifeq ($(CONFIG_WINDOWS_NATIVE),y)
 define CLEAN
 	$(Q) if exist *$(OBJEXT) (del /f /q *$(OBJEXT))
