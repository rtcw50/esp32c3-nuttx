+# Auto-discover C3 linker flags from all apps
+C3_LDFLAGS_DIR := $(APPDIR)$(DELIM)c3_ldflags
+C3_LDFLAGS := $(foreach file,$(wildcard $(C3_LDFLAGS_DIR)$(DELIM)*.ldflags),$(shell cat $(file)))
+
+
 nuttx$(EXEEXT): $(HEAD_OBJ) board/libboard$(LIBEXT) $(addsuffix .tmp,$(ARCHSCRIPT))
-	$(Q) echo "LD: nuttx"
+	$(Q) echo "LD riscv: nuttx"
