--- /dev/null	2026-07-15 12:05:30.985190087 -0500
+++ tools/C3.defs	2026-06-01 08:17:35.641172740 -0500
@@ -0,0 +1,48 @@
+############################################################################
+# tools/c3.defs
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+# Licensed to the Apache Software Foundation (ASF) under one or more
+# contributor license agreements.  See the NOTICE file distributed with
+# this work for additional information regarding copyright ownership.  The
+# ASF licenses this file to you under the Apache License, Version 2.0 (the
+# "License"); you may not use this file except in compliance with the
+# License.  You may obtain a copy of the License at
+#
+#   http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+# License for the specific language governing permissions and limitations
+# under the License.
+#
+############################################################################
+
+C3C := c3c 
+
+C3CFLAGS := compile-only --single-module=yes -D NUTTX_PLATFORM --target elf-riscv32 --riscv-cpu=rvimac --custom-libc=yes --link-libc=yes --obj-out .
+
+# Create a linker command snippet that lists the undefined, weak symbols
+# in the C3 standard library.
+C3_GET_UNDEFINED_SYMBOLS = $(shell riscv-none-elf-nm  $1 | awk '$$2 == "w" || $$2 == "W" {printf " -u %s", $$3 } $$$$1 == "w" {printf " -u %s", $$2}')
+
+define C3_RENAME
+  $(Q) $(shell mv $(basename $1)$(OBJEXT) $2)
+endef
+
+# Not used: This function partially links the user file with the C3 standard library
+# to create the application object file. This is necessary because the references
+# in the application file after a c3c compile are weak and are not resolved by a 
+# normal link with the standard library object files. Also transforms module.o to
+# the long path name
+define C3_PARTIAL_LINK
+    $(Q) $(LD) -m elf32lriscv -r --gc-sections --entry=$(basename $1) -o $2 $(basename $1)$(OBJEXT)
+endef
+
+
+define C3_CREATE_LDFLAGS
+    mkdir -p $(APPDIR)$(DELIM)c3_ldflags
+    riscv-none-elf-nm $1 | awk '$$2 == "w" || $$2 == "W" {printf " -u %s", $$3 } $$1 == "w" {printf " -u %s", $$2}' > $(APPDIR)$(DELIM)c3_ldflags/$(PROGNAME).ldflags 
+endef
