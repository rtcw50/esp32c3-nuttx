+#include <nuttx/config.h>
+#include <errno.h>
+#include <syslog.h>
+
+
+#include <nuttx/lcd/lcd.h>
+#include <nuttx/lcd/ili9341.h>
+#include <nuttx/spi/spi.h>
+//#include <nuttx/video/fb.h>
+#include <nuttx/lcd/lcd_dev.h>
+#include <arch/board/board.h> 
+
+#include "espressif/esp_spi.h"
+#include "esp_board_spidev.h"
+#include "espressif/esp_gpio.h"
+
+static struct lcd_dev_s *g_lcd;
+int esp32c3_tsc_setup(struct spi_dev_s *spi, int minor);
+
+struct esp32c3_xiao_lcd_s
+{
+  struct ili9341_lcd_s ili9341;
+  struct spi_dev_s *spi;
+};
+
+static void esp32c3_xiao_lcd_select(struct ili9341_lcd_s *lcd)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_LOCK(priv->spi, true);
+  SPI_SELECT(priv->spi, SPIDEV_DISPLAY(0), true);
+}
+
+static void esp32c3_xiao_lcd_deselect(struct ili9341_lcd_s *lcd)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SELECT(priv->spi, SPIDEV_DISPLAY(0), false);
+  SPI_LOCK(priv->spi, false);
+}
+
+static int esp32c3_xiao_lcd_sendcmd(struct ili9341_lcd_s *lcd,
+                                     const uint8_t cmd)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SETBITS(priv->spi, 8);
+  SPI_CMDDATA(priv->spi, SPIDEV_DISPLAY(0), true);
+  SPI_SEND(priv->spi, cmd);
+  SPI_CMDDATA(priv->spi, SPIDEV_DISPLAY(0), false);
+  return OK;
+}
+
+static int esp32c3_xiao_lcd_sendparam(struct ili9341_lcd_s *lcd,
+                                       const uint8_t param)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SETBITS(priv->spi, 8);
+  SPI_CMDDATA(priv->spi, SPIDEV_DISPLAY(0), false);
+  SPI_SEND(priv->spi, param);
+  return OK;
+}
+
+static int esp32c3_xiao_lcd_recvparam(struct ili9341_lcd_s *lcd,
+                                      uint8_t *param)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SETBITS(priv->spi, 8);
+  SPI_CMDDATA(priv->spi, SPIDEV_DISPLAY(0), false);
+  *param = (uint8_t)(SPI_SEND(priv->spi, 0) & 0xff);
+  return OK;
+}
+
+static int esp32c3_xiao_lcd_sendgram(struct ili9341_lcd_s *lcd,
+                                      const uint16_t *wd,
+                                      uint32_t nwords)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SETBITS(priv->spi, 16);
+  SPI_SNDBLOCK(priv->spi, wd, nwords);
+  return OK;
+}
+
+static int esp32c3_xiao_lcd_recvgram(struct ili9341_lcd_s *lcd,
+                                      uint16_t *wd,
+                                      uint32_t nwords)
+{
+  struct esp32c3_xiao_lcd_s *priv =
+    (struct esp32c3_xiao_lcd_s *)lcd;
+
+  SPI_SETBITS(priv->spi, 16);
+  SPI_RECVBLOCK(priv->spi, wd, nwords);
+  return OK;
+}
+
+static int esp32c3_xiao_lcd_backlight(struct ili9341_lcd_s *lcd, int level)
+{
+  return OK;
+}
+
+static int board_lcd_ioctl(FAR struct lcd_dev_s *dev, int cmd, unsigned long arg)
+{
+  switch (cmd)
+    {
+      /* Handle custom board commands here (e.g., backlight control GPIOs) */
+      default:
+        return -ENOTTY; /* Command not supported */
+    }
+}
+
+#if 0
+int esp32c3_xiao_lcd_initialize(void)
+{
+
+  /* Register the device node as a POSIX Framebuffer (/dev/fb0) */
+#ifndef CONFIG_VIDEO_FB
+# error "CONFIG_VIDEO_FB is not defined. Please enable it in your configuration."
+#endif
+  /* This eventually calls board_lcd_initialize() to initialize the LCD and register 
+  the device node as a POSIX Framebuffer (/dev/fb0) */
+
+  int fb_ret = fb_register(0, 0);
+  if (fb_ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: fb_register failed: %d\n", fb_ret);
+      return fb_ret;
+    }
+
+  syslog(LOG_INFO, "ILI9341: Driver registered successfully at /dev/fb0\n");
+
+  return OK;
+}
+#endif
+
+int board_lcd_initialize(void)
+{
+  static struct esp32c3_xiao_lcd_s priv;
+
+  int ret;
+
+
+  priv.spi = esp_spibus_initialize(ESPRESSIF_SPI2);
+  if (!priv.spi) {
+      return -ENODEV;
+  }
+
+#ifdef CONFIG_LCD_ILI9341
+  priv.ili9341.select    = esp32c3_xiao_lcd_select;
+  priv.ili9341.deselect  = esp32c3_xiao_lcd_deselect;
+  priv.ili9341.sendcmd   = esp32c3_xiao_lcd_sendcmd;
+  priv.ili9341.sendparam = esp32c3_xiao_lcd_sendparam;
+  priv.ili9341.recvparam = esp32c3_xiao_lcd_recvparam;
+  priv.ili9341.sendgram  = esp32c3_xiao_lcd_sendgram;
+  priv.ili9341.recvgram  = esp32c3_xiao_lcd_recvgram;
+  priv.ili9341.backlight = esp32c3_xiao_lcd_backlight;
+
+  /* Reset the display */
+  esp_configgpio(GPIO_LCD_RST, OUTPUT | PULLUP | DRIVE_2);
+
+  /* 2. Perform a hardware reset sequence */
+  esp_gpiowrite(GPIO_LCD_RST, false); /* Pull low to reset */
+  up_mdelay(20);                              /* Wait 20ms */
+  esp_gpiowrite(GPIO_LCD_RST, true);  /* Pull high to release */
+  up_mdelay(120);
+
+  if (g_lcd == NULL) {
+    g_lcd = ili9341_initialize(&priv.ili9341, 0);
+    if (!g_lcd)
+    {
+      return -ENODEV;
+    }
+  }
+
+  /* Handle unsupported ioctl commands */
+  if (g_lcd->ioctl == NULL) {
+      g_lcd->ioctl = board_lcd_ioctl;
+  }
+
+    /* Deliver power to the display controller */
+  g_lcd->setpower(g_lcd, CONFIG_LCD_MAXPOWER);
+
+  ret = lcddev_register(0);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: lcddev_register failed: %d\n", ret);
+      return ret;
+    }
+#endif
+
+#if CONFIG_INPUT_ADS7843E
+  ret = esp32c3_tsc_setup(priv.spi, 0);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: esp32c3_tsc_setup() failed: %d\n", ret);
+    }
+#endif
+
+  return OK;
+}
+
+void board_lcd_uninitialize(void)
+{
+  if (g_lcd)
+    {
+      g_lcd->setpower(g_lcd, 0);
+      g_lcd = NULL;
+    }
+}
+
+FAR struct lcd_dev_s *board_lcd_getdev(int devno)
+{
+  if (devno == 0)
+    {
+      return g_lcd;
+    }
+  else
+    {
+      return NULL;
+    }
+} 
