+/****************************************************************************
+ * boards/risc-v/esp32c3/esp32c3-xiao/src/esp32c3_tsc.c
+ *
+ * ADS7843E / XPT2046 glue for ESP32C3-XIAO (no T_IRQ usage — polling mode)
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <syslog.h>
+#include <errno.h>
+
+#include <nuttx/spi/spi.h>
+#include <nuttx/irq.h>
+#include <nuttx/input/ads7843e.h>
+
+#include "espressif/esp_spi.h"
+#include "espressif/esp_gpio.h"
+
+#include "esp32c3-xiao.h"
+
+/* Hardware wiring (from your message):
+ *  T_CS  -> GPIO20
+ *  T_DIN -> GPIO10 (MOSI)
+ *  T_DOUT-> GPIO6  (MISO)
+ *  T_CLK -> GPIO8  (SCK)
+ *  T_IRQ -> OPEN (not used)
+ *
+ * Note: SPI CS mapping is controlled by CONFIG_ESPRESSIF_SPI2_CSPIN or
+ *       by software CS (CONFIG_ESPRESSIF_SPI_SWCS). Ensure the build
+ *       config maps the SPI CS to GPIO20 or enable SWCS and control CS
+ *       from software if needed.
+ */
+
+/* If you want to centralize pin defines, move/adjust these in board headers. */
+#define TSC_CS_GPIO     20  /* GPIO20 (T_CS) - ensure SPI CS mapping or SWCS uses this */
+
+/* Forward declarations for callbacks required by ads7843e driver */
+static int  tsc_attach(struct ads7843e_config_s *state, xcpt_t isr);
+static void tsc_enable(struct ads7843e_config_s *state, bool enable);
+static void tsc_clear(struct ads7843e_config_s *state);
+static bool tsc_busy(struct ads7843e_config_s *state);
+static bool tsc_pendown(struct ads7843e_config_s *state);
+
+/* ads7843e configuration structure passed to the driver */
+static struct ads7843e_config_s g_tscinfo =
+{
+  .frequency = CONFIG_ADS7843E_FREQUENCY,
+  .attach    = tsc_attach,
+  .enable    = tsc_enable,
+  .clear     = tsc_clear,
+  .busy      = tsc_busy,
+  .pendown   = tsc_pendown,
+};
+
+/* Callbacks ---------------------------------------------------------------*/
+
+/* No IRQ usage: attach is a no-op */
+static int tsc_attach(struct ads7843e_config_s *state, xcpt_t isr)
+{
+  return OK;
+}
+
+/* enable/disable IRQ: no-op since we do not configure an interrupt */
+static void tsc_enable(struct ads7843e_config_s *state, bool enable)
+{
+  (void)state;
+  (void)enable;
+}
+
+/* clear pending IRQ: no-op */
+static void tsc_clear(struct ads7843e_config_s *state)
+{
+  (void)state;
+}
+
+/* BUSY pin not used in this wiring */
+static bool tsc_busy(struct ads7843e_config_s *state)
+{
+  (void)state;
+  return false;
+}
+
+/* PENIRQ not used per user requirement.
+ * Return 'true' to force polling by the driver's worker (no IRQ).
+ * Note: this will make the driver sample when it expects pen down;
+ *       tune thresholds or modify pendown() later if you add a pen detect pin.
+ */
+static bool tsc_pendown(struct ads7843e_config_s *state)
+{
+  (void)state;
+  return true;
+}
+
+/* Public setup function called from board bringup */
+int esp32c3_tsc_setup(struct spi_dev_s *spi, int minor)
+{
+  int ret;
+
+  /* Optionally configure the T_CS GPIO here if you're using software CS.
+   * If hardware CS mapping is used (CONFIG_ESPRESSIF_SPI2_CSPIN == TSC_CS_GPIO)
+   * the SPI driver will handle CS. If you use SWCS, ensure CONFIG_ESPRESSIF_SPI_SWCS
+   * is enabled and configure the GPIO accordingly.
+   */
+
+#ifdef CONFIG_ESPRESSIF_SPI_SWCS
+  esp_configgpio(TSC_CS_GPIO, OUTPUT | PULLUP | DRIVE_2);
+  esp_gpiowrite(TSC_CS_GPIO, true);
+#endif
+
+  /* Register the ADS7843E driver (this schedules the driver's worker).
+   * The driver will use the provided callbacks (which are no-ops or polling).
+   */
+  ret = ads7843e_register(spi, &g_tscinfo, minor);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "TSC: ads7843e_register failed: %d\n", ret);
+      return ret;
+    }
+
+  syslog(LOG_INFO, "TSC: XPT2046/ADS7843E registered as /dev/input%d\n", minor);
+  return OK;
+}
