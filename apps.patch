-$(PROGLIST): $(MAINCOBJ) $(MAINCXXOBJ) $(MAINRUSTOBJ) $(MAINZIGOBJ) $(MAINDOBJ) $(MAINSWIFTOBJ)
+$(MAINZENCOBJ): $(PREFIX)%$(ZENCEXT)$(SUFFIX)$(OBJEXT): %$(ZENCEXT)
+	$(if $(and $(CONFIG_MODULES),$(CELFFLAGS)), \
+		$(call ELFCOMPILEZENC, $<, $@), $(call COMPILEZENC, $<, $@))
+
+$(MAINC3OBJ): $(PREFIX)%$(C3EXT)$(SUFFIX)$(OBJEXT): %$(C3EXT)
+	$(if $(and $(CONFIG_MODULES),$(CELFFLAGS)), \
+		$(call ELFCOMPILEC3, $<, $@), $(call COMPILEC3, $<, $@))
+#	$(call C3_RENAME, $<, $@)
+
+$(PROGLIST): $(MAINCOBJ) $(MAINCXXOBJ) $(MAINRUSTOBJ) $(MAINZIGOBJ) $(MAINDOBJ) $(MAINSWIFTOBJ) $(MAINZENCOBJ) $(MAINC3OBJ)
 	$(Q) mkdir -p $(BINDIR)
 	$(call ELFLD, $(PROGOBJ_$@), $(call CONVERT_PATH,$@))
 	$(Q) chmod +x $@
@@ -348,6 +392,20 @@ $(MAINSWIFTOBJ): $(PREFIX)%$(SWIFTEXT)$(SUFFIX)$(OBJEXT): %$(SWIFTEXT)
 	$(if $(and $(CONFIG_MODULES),$(CELFFLAGS)), \
 		$(call ELFCOMPILESWIFT, $<, $@), $(call COMPILESWIFT, $<, $@))
 
+$(MAINZENCOBJ): $(PREFIX)%$(ZENCEXT)$(SUFFIX)$(OBJEXT): %$(ZENCEXT)
+	$(eval $<_CFLAGS += ${DEFINE_PREFIX}main=$(addsuffix _main,$(PROGNAME_$@)))
+	$(eval $<_CELFFLAGS += ${DEFINE_PREFIX}main=$(addsuffix _main,$(PROGNAME_$@)))
+	$(if $(and $(CONFIG_MODULES),$(CELFFLAGS)), \
+		$(call ELFCOMPILEZENC, $<, $@), $(call COMPILEZENC, $<, $@))
+
+$(MAINC3OBJ): $(PREFIX)%$(C3EXT)$(SUFFIX)$(OBJEXT): %$(C3EXT)
+	$(eval $<_CFLAGS += ${DEFINE_PREFIX}main=$(addsuffix _main,$(PROGNAME_$@)))
+	$(eval $<_C3ELFFLAGS += ${DEFINE_PREFIX}main=$(addsuffix _main,$(PROGNAME_$@)))
+	$(if $(and $(CONFIG_MODULES),$(CELFFLAGS)), \
+		$(call ELFCOMPILEC3, $<, $@), $(call COMPILEC3, $<, $@))
+#	$(call C3_RENAME, $<, $@)
+#	$(call C3_PARTIAL_LINK, $<, $@)
+
 install::
 	@:
 
