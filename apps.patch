+$(ZENCOBJS): $(PREFIX)%$(SUFFIX)$(OBJEXT): %$(ZENCEXT)
+	$(if $(and $(CONFIG_MODULES), $(CELFFLAGS)), \
+		$(call ELFCOMPILEZENC, $<, $@), $(call COMPILEZENC, $<, $@))
+
+# Note that C3 compilation will produce .o files directly and does not
+# support -o for compile-only. We use a script to convert the main.o to
+# fully qualified filename used by nuttx.
+$(C3OBJS): $(PREFIX)%$(SUFFIX)$(OBJEXT): %$(C3EXT)
+	$(if $(and $(CONFIG_MODULES), $(CELFFLAGS)), \
+		$(call ELFCOMPILEC3, $<, $@), $(call COMPILEC3, $<, $@))
+#	$(call C3_RENAME, $<, $@)
+
 AROBJS :=
 ifneq ($(OBJS),)
 SORTOBJS := $(sort $(OBJS))
