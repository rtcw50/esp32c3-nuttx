@@ -214,6 +222,21 @@ define ELFCOMPILESWIFT
 	$(ECHO_END)
 endef
 
+define ELFCOMPILEZENC
+	$(ECHO_BEGIN)"ZENC:  $1 " 
+	$(Q) $(ZENC)  $(ZENCELFFLAGS) $($(strip $1)_ZENCELFFLAGS) $1 -o $(basename $1).zcc
+	$(ECHO_BEGIN)"CC: $(basename $1).zcc "
+	$(Q) $(MODULECC) -x c -c $(CFLAGS) $(MODCFLAGS) $($(strip $1)_CELFFLAGS) $(basename $1).zcc -o $2
+	$(ECHO_END)
+endef
+
+define ELFCOMPILEC3
+	$(ECHO_BEGIN)"C3C:  $1 " 
+	$(Q) $(C3C)  $(C3ELFFLAGS) $($(strip $1)_C3ELFFLAGS) $1 -o $2
+	$(Q) $(call C3_CREATE_LDFLAGS,$2)
+	$(ECHO_END)
+endef
+
 define ELFLD
 	$(ECHO_BEGIN)"LD: $2 "
 	$(Q) $(MODULELD) $(MODLDFLAGS) $(LDMAP) $(LDLIBPATH) $(ARCHCRT0OBJ) $1 $(LDSTARTGROUP) $(LDLIBS) $(LDENDGROUP) -o $2
