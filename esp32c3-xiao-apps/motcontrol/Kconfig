#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config  ESP32C3_XIAO_MOTCONTROL 
	tristate "\"motcontrol\" example"
	default n
	---help---
		Enable the \"motcontrol\" example

if ESP32C3_XIAO_MOTCONTROL

config ESP32C3_XIAO_MOTCONTROL_PROGNAME
	string "Program name"
	default "motcontrol"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config ESP32C3_XIAO_MOTCONTROL_PRIORITY
	int "motcontrol task priority"
	default 100

config ESP32C3_XIAO_MOTCONTROL_STACKSIZE
	int "motcontrol stack size"
	default DEFAULT_TASK_STACKSIZE

endif
