#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config  ESP32C3_XIAO_BLINKC3 
	tristate "\"blinkc3\" example"
	default n
	---help---
		Enable the \"blinkc3\" example

if ESP32C3_XIAO_BLINKC3

config ESP32C3_XIAO_BLINKC3_PROGNAME
	string "Program name"
	default "blinkc3"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config ESP32C3_XIAO_BLINKC3_PRIORITY
	int "blinkc3 task priority"
	default 100

config ESP32C3_XIAO_BLINKC3_STACKSIZE
	int "blinkc3 stack size"
	default DEFAULT_TASK_STACKSIZE

endif
