#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config  ESP32C3_XIAO_MYLVGL 
	tristate "\"mylvgl\" example"
	default n
	---help---
		Enable the \"mylvgl\" example

if ESP32C3_XIAO_MYLVGL

config ESP32C3_XIAO_MYLVGL_PROGNAME
	string "Program name"
	default "mylvgl"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config ESP32C3_XIAO_MYLVGL_PRIORITY
	int "mylvgl task priority"
	default 100

config ESP32C3_XIAO_MYLVGL_STACKSIZE
	int "mylvgl stack size"
    default 16358 
#	default DEFAULT_TASK_STACKSIZE

endif
